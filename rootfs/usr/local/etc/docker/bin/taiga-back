#!/usr/bin/env bash
# shellcheck shell=bash
# - - - - - - - - - - - - - - - - - - - - - - - - -
##@Version           :  202610102130-git
# @@Author           :  CasjaysDev
# @@Contact          :  CasjaysDev <docker-admin@casjaysdev.pro>
# @@License          :  WTFPL
# @@Copyright        :  Copyright: (c) 2026 CasjaysDev
# @@File             :  taiga-back
# @@Description      :  starts the taiga-back api (gunicorn) on 127.0.0.1:8000
# @@Terminal App     :  no
# @@sudo/root        :  no
# - - - - - - - - - - - - - - - - - - - - - - - - -
# shellcheck disable=SC1091,SC2154
set -eo pipefail
. /usr/local/etc/docker/env/taiga.sh
# - - - - - - - - - - - - - - - - - - - - - - - - -
cd "$TAIGA_ROOT/taiga-back"
exec "$TAIGA_VENV/venv-back/bin/taiga-back" -m gunicorn taiga.wsgi:application \
  --name taiga-back \
  --bind "127.0.0.1:$TAIGA_BACK_PORT" \
  --workers "$GUNICORN_WORKERS" \
  --worker-tmp-dir /dev/shm \
  --log-level info \
  --access-logfile -
# - - - - - - - - - - - - - - - - - - - - - - - - -
# ex: ts=2 sw=2 et filetype=sh
# - - - - - - - - - - - - - - - - - - - - - - - - -
